# Renombrar a azure-static-web-apps.yml cuando exista el recurso en Azure
# y el secreto AZURE_STATIC_WEB_APPS_API_TOKEN esté creado en el repositorio.
name: Azure Static Web Apps
on:
  workflow_dispatch:
jobs:
  desplegar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: Azure/static-web-apps-deploy@v1
        with:
          azure_static_web_apps_api_token: ${{ secrets.AZURE_STATIC_WEB_APPS_API_TOKEN }}
          action: upload
          app_location: /
          skip_app_build: true
