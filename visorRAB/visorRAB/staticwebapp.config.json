{
  "mimeTypes": { ".geojson": "application/geo+json", ".webmanifest": "application/manifest+json" },
  "globalHeaders": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin" },
  "routes": [
    { "route": "/data/*", "headers": { "cache-control": "public, max-age=3600" } },
    { "route": "/vendor/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/sw.js", "headers": { "cache-control": "no-cache" } }
  ],
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/data/*", "/vendor/*", "/assets/*", "/css/*", "/js/*"] }
}
